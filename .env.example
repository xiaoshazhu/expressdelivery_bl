# 默认本地演示：所有返回轨迹均为模拟数据。不要用作线上商业服务。
PORT=8787
HOST=127.0.0.1
PROVIDER_MODE=mock
# 阿里云市场快证快递查询（推荐）。APPCODE 鉴权只需 AppCode；AppKey/AppSecret 为签名鉴权预留。
# PROVIDER_MODE=aliyun_kzexpress
# ALIYUN_EXPRESS_APPCODE=
# ALIYUN_EXPRESS_APPKEY=
# ALIYUN_EXPRESS_APPSECRET=
# 购买快递100企业版实时查询后，将上方模式改为 kuaidi100，并填写企业管理后台提供的凭证。
# PROVIDER_MODE=kuaidi100
# KUAIDI100_KEY=
# KUAIDI100_CUSTOMER=
# 统一本地 MySQL 数据库配置 (可在 Navicat 中直接查看与维护)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gya_express

# 计费/套餐（开发环境默认不强制扣减；生产配置平台下发授权后再设为 true）
BILLING_CONFIG_PATH=./packages.json
BILLING_ENFORCE=true
# 平台调用套餐、授权、退款接口时使用；不要提交真实 Token
API_TOKEN=
# 支付渠道由插件另行实现；未配置时只提供套餐和授权接口，不返回可支付二维码
PAYMENT_MODE=

# 可选：接入外部 MCP/平台计费账本。配置后余额、扣次、订单、回调和退款都走外部服务。
MCP_BILLING_URL=
MCP_BILLING_TOKEN=
MCP_BALANCE_PATH=/balance
MCP_CONSUME_PATH=/usage/consume
MCP_CREATE_ORDER_PATH=/payments/orders
MCP_PAYMENT_CALLBACK_PATH=/payments/callback
MCP_REFUND_PATH=/payments/refund
MCP_ORDER_STATUS_PATH=/payments/order-status

# 真实飞书连接在插件中输入 personalBaseToken，仅保存在后端短期内存会话。
# 若设为 production，当前演示服务主动拒绝启动；上线须实现正式授权和真实服务商适配。
NODE_ENV=development


# 安汇数智线上平台代理（仅服务端使用；配置后企业登记走线上平台）
PLATFORM_API_URL=https://platform.feishu.anhuishuzhi.com
PLATFORM_API_TOKEN=
PLATFORM_WS_URL=wss://platform.feishu.anhuishuzhi.com/api/v1/ws/plugin
PLUGIN_ID=

# 微信支付 Native 真实收款（必须填写安汇数智商户后台提供的值，不能使用示例值）
# 配置完整后，充值弹窗才会显示可被手机微信识别的真实收款二维码。
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_CERT_SERIAL_NO=
WECHAT_NOTIFY_CERT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_KEY_PATH=
WECHAT_CERT_PATH=
# 必须是公网 HTTPS 地址，并通过内网穿透转发到本机 /api/pay/wechat/notify
WECHAT_NOTIFY_URL=https://你的内网穿透域名/api/pay/wechat/notify
# 开发演示时可设为 true；真实收款时必须删除或设为 false
MOCK_PAY=false
